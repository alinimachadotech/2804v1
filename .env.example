APP_NAME="API do Gerax Manager"
APP_VERSION="0.1.0"
APP_ENV="local"
DEBUG=true

# Nunca coloque segredos reais neste arquivo.
ROUTERS_JSON=[]

GRAFANA_PORT=3180
ADMINER_PORT=8187
PROMETHEUS_PORT=9090

MARIADB_PORT=3317
MARIADB_DATABASE=gerax_manager
MARIADB_USER=gerax
MARIADB_PASSWORD=change-me-local-password
MARIADB_ROOT_PASSWORD=change-me-root-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

NEXTROUTER_VERIFY_SSL=true
NEXTROUTER_TIMEOUT_SECONDS=60
BALANCE_CACHE_TTL_SECONDS=60
CUSTOMER_CACHE_TTL_SECONDS=60
ONLINE_CACHE_TTL_SECONDS=60
ROUTER_REQUEST_TIMEOUT_SECONDS=60
